# 공개 저장소: 코드와 사이트 데이터(web/static/data)만 올린다. runs/·원자료·보고서 원본은 올리지 않는다.
# 허용 목록 방식: 전부 무시하고 필요한 것만 연다.
/*
!/.gitignore
!/README.md
!/GUIDE.md
!/.github/
!/run.py
!/measure_*.sh

!/scenarios/

!/dataset/
/dataset/*
!/dataset/nasa/
/dataset/nasa/*
!/dataset/nasa/fetch.py
!/dataset/nasa/push.py
!/dataset/nasa/manifest.csv

!/report/
/report/*
!/report/extract.py
!/report/export_web.py
!/report/perstep.py
!/report/terms.py
!/report/publish.sh
!/report/build_report.py
!/report/pages.py
!/report/web/

!/wl/
/wl/.private/
# 데이터셋에서 뽑은 값·trace 조각·TC·결과는 wl/.private 에만 둔다 (공개 금지)

!/web/
/web/node_modules/
/web/build/
/web/.svelte-kit/
/web/.private/

__pycache__/
.DS_Store
