{
  "schemaVersion": 1,
  "kind": "scenario",
  "name": "[UX-fsio] A7 홈↔YouTube 복귀 ×10",
  "description": "[A7 · P2] YouTube 를 띄워 둔 채 홈과 앱을 10번 오간다. 백그라운드 진입 때 상태 저장 write 를 본다.",
  "repeatCount": 3,
  "steps": [
    {
      "type": "launch_app",
      "params": {
        "package_name": "com.google.android.youtube",
        "clear_mode": "force_stop",
        "wait_seconds": "6",
        "label": "YouTube 실행"
      }
    },
    {
      "type": "key",
      "params": {
        "keycode": "3",
        "label": "홈"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "2",
        "label": "대기 2초"
      }
    },
    {
      "type": "trace_start",
      "params": {
        "trace_type": "fsio_ufs",
        "window_seconds": "1",
        "include_vfs": "false",
        "include_dram": "false",
        "label": "측정 시작"
      }
    },
    {
      "type": "launch_app",
      "params": {
        "package_name": "com.google.android.youtube",
        "clear_mode": "none",
        "wait_seconds": "3",
        "label": "YouTube 로 복귀"
      }
    },
    {
      "type": "key",
      "params": {
        "keycode": "3",
        "label": "홈"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "2",
        "label": "홈 대기"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "3",
        "label": "writeback 배수 대기"
      }
    },
    {
      "type": "trace_stop",
      "params": {
        "trace_type": "fsio_ufs",
        "label": "측정 종료"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "dumpsys window | grep mCurrentFocus",
        "label": "화면 확인"
      }
    },
    {
      "type": "stop_app",
      "params": {
        "package_name": "com.google.android.youtube",
        "label": "앱 종료"
      }
    }
  ],
  "loops": [
    {
      "startStep": 4,
      "endStep": 6,
      "count": 10
    }
  ],
  "requirements": {
    "packages": [
      "com.google.android.youtube"
    ],
    "sourceWidth": 1272,
    "sourceHeight": 2772,
    "traceType": "fsio_ufs"
  },
  "origin": {
    "deviceModel": "CPH2749"
  }
}
