{
  "schemaVersion": 1,
  "kind": "scenario",
  "name": "[UX-fsio] B1i Chrome 위키 (시크릿 모드)",
  "description": "[B1i · P2] B1 과 같은 동작을 시크릿 탭에서. 시크릿은 HTTP 캐시·쿠키를 메모리에만 두므로 B1 대비 write 가 얼마나 줄어드는지 비교용. 준비: Chrome 처음 실행 화면 완료 / dry-run 확인: 메뉴·시크릿 탭·주소창 요소 이름",
  "repeatCount": 3,
  "steps": [
    {
      "type": "shell",
      "params": {
        "cmd": "settings put secure selected_input_method_subtype -1097284911; ime set com.google.android.inputmethod.latin/com.android.inputmethod.latin.LatinIME >/dev/null; settings get secure selected_input_method_subtype",
        "label": "키보드 영문(Alphabet)으로"
      }
    },
    {
      "type": "stop_app",
      "params": {
        "package_name": "com.android.chrome",
        "label": "Chrome 종료"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "rm -rf /data/data/com.android.chrome/cache/Cache /data/data/com.android.chrome/cache/image_manager_disk_cache; echo ok",
        "label": "Chrome 디스크 캐시 비우기"
      }
    },
    {
      "type": "launch_app",
      "params": {
        "package_name": "com.android.chrome",
        "clear_mode": "force_stop",
        "wait_seconds": "4",
        "label": "Chrome 실행"
      }
    },
    {
      "type": "tap_element",
      "params": {
        "element_resource_id": "com.android.chrome:id/menu_button",
        "label": "메뉴 열기"
      }
    },
    {
      "type": "tap_element",
      "params": {
        "element_text": "새 시크릿 탭",
        "label": "새 시크릿 탭"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "2",
        "label": "대기 2초"
      }
    },
    {
      "type": "trace_start",
      "params": {
        "trace_type": "fsio_ufs",
        "window_seconds": "1",
        "include_vfs": "false",
        "include_dram": "false",
        "label": "측정 시작"
      }
    },
    {
      "type": "tap_element",
      "params": {
        "element_resource_id": "com.android.chrome:id/url_bar",
        "label": "주소창"
      }
    },
    {
      "type": "text",
      "params": {
        "input_text": "https://en.m.wikipedia.org/wiki/Solid-state_drive",
        "submit": "true",
        "label": "위키 SSD 문서 열기"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "10",
        "label": "로딩 대기"
      }
    },
    {
      "type": "scroll",
      "params": {
        "direction": "down",
        "count": "8",
        "pause": "1.5",
        "duration": "300",
        "label": "문서 스크롤"
      }
    },
    {
      "type": "tap_element",
      "params": {
        "element_resource_id": "com.android.chrome:id/url_bar",
        "label": "주소창"
      }
    },
    {
      "type": "text",
      "params": {
        "input_text": "https://en.m.wikipedia.org/wiki/Flash_memory",
        "submit": "true",
        "label": "위키 플래시 메모리 문서 열기"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "10",
        "label": "로딩 대기"
      }
    },
    {
      "type": "scroll",
      "params": {
        "direction": "down",
        "count": "8",
        "pause": "1.5",
        "duration": "300",
        "label": "문서 스크롤"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "3",
        "label": "writeback 배수 대기"
      }
    },
    {
      "type": "trace_stop",
      "params": {
        "trace_type": "fsio_ufs",
        "label": "측정 종료"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "dumpsys window | grep mCurrentFocus",
        "label": "화면 확인"
      }
    },
    {
      "type": "stop_app",
      "params": {
        "package_name": "com.android.chrome",
        "label": "Chrome 종료 (시크릿 탭 폐기)"
      }
    }
  ],
  "loops": [],
  "requirements": {
    "packages": [
      "com.android.chrome"
    ],
    "sourceWidth": 1272,
    "sourceHeight": 2772,
    "traceType": "fsio_ufs"
  },
  "origin": {
    "deviceModel": "CPH2749"
  }
}
