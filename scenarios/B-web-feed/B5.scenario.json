{
  "schemaVersion": 1,
  "kind": "scenario",
  "name": "[UX-fsio] B5 Chrome 이미지 많은 문서",
  "description": "[B5 · P2] 국기 이미지 200여 개가 있는 위키 문서를 캐시를 비우고 열어 30번 스크롤. B1(글 위주 문서)과 캐시 write 양 비교. 준비: Chrome 처음 실행 화면 완료",
  "repeatCount": 3,
  "steps": [
    {
      "type": "stop_app",
      "params": {
        "package_name": "com.android.chrome",
        "label": "Chrome 종료"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "rm -rf /data/data/com.android.chrome/cache/Cache /data/data/com.android.chrome/cache/image_manager_disk_cache; echo ok",
        "label": "Chrome 디스크 캐시 비우기"
      }
    },
    {
      "type": "trace_start",
      "params": {
        "trace_type": "fsio_ufs",
        "window_seconds": "1",
        "include_vfs": "false",
        "include_dram": "false",
        "label": "측정 시작"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "am start -a android.intent.action.VIEW -d https://en.m.wikipedia.org/wiki/Gallery_of_sovereign_state_flags -p com.android.chrome",
        "label": "국기 갤러리 문서 열기"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "10",
        "label": "로딩 대기"
      }
    },
    {
      "type": "scroll",
      "params": {
        "direction": "down",
        "count": "30",
        "pause": "1",
        "duration": "300",
        "label": "이미지 문서 스크롤"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "3",
        "label": "writeback 배수 대기"
      }
    },
    {
      "type": "trace_stop",
      "params": {
        "trace_type": "fsio_ufs",
        "label": "측정 종료"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "dumpsys window | grep mCurrentFocus",
        "label": "화면 확인"
      }
    },
    {
      "type": "stop_app",
      "params": {
        "package_name": "com.android.chrome",
        "label": "앱 종료"
      }
    }
  ],
  "loops": [],
  "requirements": {
    "packages": [
      "com.android.chrome"
    ],
    "sourceWidth": 1272,
    "sourceHeight": 2772,
    "traceType": "fsio_ufs"
  },
  "origin": {
    "deviceModel": "CPH2749"
  }
}
