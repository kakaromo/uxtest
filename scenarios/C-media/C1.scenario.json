{
  "schemaVersion": 1,
  "kind": "scenario",
  "name": "[UX-fsio] C1 YouTube 영상 3분",
  "description": "[C1 · P1] 정해 둔 4K 영상(JWST, 7시간)을 링크로 열어 3분 재생. Premium 계정이라 광고가 없다. 재생 화질은 자동.",
  "repeatCount": 3,
  "steps": [
    {
      "type": "launch_app",
      "params": {
        "package_name": "com.google.android.youtube",
        "clear_mode": "force_stop",
        "wait_seconds": "6",
        "label": "YouTube 실행"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "am start -a android.intent.action.VIEW -d \"https://www.youtube.com/watch?v=0_0HJbNzGb8\" -p com.google.android.youtube >/dev/null",
        "label": "영상 열기 (링크)"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "6",
        "label": "영상 로딩"
      }
    },
    {
      "type": "youtube",
      "params": {
        "action": "watch",
        "seconds": "0",
        "label": "재생 준비 확인"
      }
    },
    {
      "type": "trace_start",
      "params": {
        "trace_type": "fsio_ufs",
        "window_seconds": "1",
        "include_vfs": "false",
        "include_dram": "false",
        "label": "측정 시작"
      }
    },
    {
      "type": "youtube",
      "params": {
        "action": "watch",
        "seconds": "180",
        "ad_timeout": "180",
        "label": "본영상 재생 3분"
      }
    },
    {
      "type": "trace_stop",
      "params": {
        "trace_type": "fsio_ufs",
        "label": "측정 종료"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "dumpsys window | grep mCurrentFocus",
        "label": "화면 확인"
      }
    },
    {
      "type": "stop_app",
      "params": {
        "package_name": "com.google.android.youtube",
        "label": "앱 종료"
      }
    }
  ],
  "loops": [],
  "requirements": {
    "packages": [
      "com.google.android.youtube"
    ],
    "sourceWidth": 1272,
    "sourceHeight": 2772,
    "traceType": "fsio_ufs"
  },
  "origin": {
    "deviceModel": "CPH2749"
  }
}
