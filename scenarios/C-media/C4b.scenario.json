{
  "schemaVersion": 1,
  "kind": "scenario",
  "name": "[UX-fsio] C4b YouTube 1080p 3분",
  "description": "[C4b · P2] C1 과 같은 영상을 화질 1080p 로 고정해 3분 재생. 화질별 버퍼(캐시) write 차이를 본다.",
  "repeatCount": 3,
  "steps": [
    {
      "type": "launch_app",
      "params": {
        "package_name": "com.google.android.youtube",
        "clear_mode": "force_stop",
        "wait_seconds": "6",
        "label": "YouTube 실행"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "am start -a android.intent.action.VIEW -d \"https://www.youtube.com/watch?v=0_0HJbNzGb8\" -p com.google.android.youtube >/dev/null",
        "label": "영상 열기 (링크)"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "6",
        "label": "영상 로딩"
      }
    },
    {
      "type": "youtube",
      "params": {
        "action": "watch",
        "seconds": "0",
        "label": "재생 준비 확인"
      }
    },
    {
      "type": "youtube",
      "params": {
        "action": "quality",
        "quality": "1080p",
        "label": "화질 1080p 고정"
      }
    },
    {
      "type": "trace_start",
      "params": {
        "trace_type": "fsio_ufs",
        "window_seconds": "1",
        "include_vfs": "false",
        "include_dram": "false",
        "label": "측정 시작"
      }
    },
    {
      "type": "youtube",
      "params": {
        "action": "watch",
        "seconds": "180",
        "ad_timeout": "180",
        "label": "1080p 재생 3분"
      }
    },
    {
      "type": "trace_stop",
      "params": {
        "trace_type": "fsio_ufs",
        "label": "측정 종료"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "dumpsys window | grep mCurrentFocus",
        "label": "화면 확인"
      }
    },
    {
      "type": "stop_app",
      "params": {
        "package_name": "com.google.android.youtube",
        "label": "앱 종료"
      }
    }
  ],
  "loops": [],
  "requirements": {
    "packages": [
      "com.google.android.youtube"
    ],
    "sourceWidth": 1272,
    "sourceHeight": 2772,
    "traceType": "fsio_ufs"
  },
  "origin": {
    "deviceModel": "CPH2749"
  }
}
