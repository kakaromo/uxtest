{
  "schemaVersion": 1,
  "kind": "scenario",
  "name": "[UX-fsio] D2 버스트샷 3초",
  "description": "[D2 · P1] 셔터를 3초 길게 눌러 연속 촬영 (실측 3초 ≈ 20장, Cshot 폴더). 측정 후 지운다.",
  "repeatCount": 3,
  "steps": [
    {
      "type": "shell",
      "params": {
        "cmd": "touch /data/local/tmp/ux_mark",
        "label": "새 파일 기준 시각 기록"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "am start -W -a android.media.action.STILL_IMAGE_CAMERA",
        "label": "카메라(사진) 실행"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "3",
        "label": "카메라 준비"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "input tap 635 2420",
        "label": "워밍업 1장"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "4",
        "label": "대기 4초"
      }
    },
    {
      "type": "trace_start",
      "params": {
        "trace_type": "fsio_ufs",
        "window_seconds": "1",
        "include_vfs": "false",
        "include_dram": "false",
        "label": "측정 시작"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "input swipe 635 2420 635 2420 3000",
        "label": "셔터 3초 누르기"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "8",
        "label": "저장 대기"
      }
    },
    {
      "type": "trace_stop",
      "params": {
        "trace_type": "fsio_ufs",
        "label": "측정 종료"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "dumpsys window | grep mCurrentFocus",
        "label": "화면 확인"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "echo CAPTURED files=$(find /storage/emulated/0/DCIM/Camera -type f -newer /data/local/tmp/ux_mark | wc -l) kb=$(find /storage/emulated/0/DCIM/Camera -type f -newer /data/local/tmp/ux_mark -exec du -k {} + | awk '{s+=$1} END {print s+0}'); for f in $(find /storage/emulated/0/DCIM/Camera -type f -newer /data/local/tmp/ux_mark); do content delete --uri content://media/external/file --where \"_data='$f'\"; rm -f \"$f\"; done; find /storage/emulated/0/DCIM/Camera/Cshot -mindepth 1 -type d -empty -delete 2>/dev/null; echo cleaned",
        "label": "촬영 파일 정리"
      }
    },
    {
      "type": "stop_app",
      "params": {
        "package_name": "com.oplus.camera",
        "label": "앱 종료"
      }
    }
  ],
  "loops": [],
  "requirements": {
    "packages": [
      "com.oplus.camera"
    ],
    "sourceWidth": 1272,
    "sourceHeight": 2772,
    "traceType": "fsio_ufs"
  },
  "origin": {
    "deviceModel": "CPH2749"
  }
}
