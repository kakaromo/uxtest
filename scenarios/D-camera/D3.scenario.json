{
  "schemaVersion": 1,
  "kind": "scenario",
  "name": "[UX-fsio] D3 동영상 30초 1080p",
  "description": "[D3 · P1] 동영상 모드는 VIDEO_CAMERA 인텐트로 바로 연다(모드 전환 UI 를 거치지 않음). 기기 기본값 1920×1080 (fixture 실측, 약 2MB/s). 측정 후 지운다.",
  "repeatCount": 3,
  "steps": [
    {
      "type": "shell",
      "params": {
        "cmd": "touch /data/local/tmp/ux_mark",
        "label": "새 파일 기준 시각 기록"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "am start -W -a android.media.action.VIDEO_CAMERA",
        "label": "카메라(동영상) 실행"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "3",
        "label": "카메라 준비"
      }
    },
    {
      "type": "trace_start",
      "params": {
        "trace_type": "fsio_ufs",
        "window_seconds": "1",
        "include_vfs": "false",
        "include_dram": "false",
        "label": "측정 시작"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "input tap 635 2420",
        "label": "녹화 시작"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "30",
        "label": "녹화 30초"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "input tap 635 2420",
        "label": "녹화 종료"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "5",
        "label": "저장 대기"
      }
    },
    {
      "type": "trace_stop",
      "params": {
        "trace_type": "fsio_ufs",
        "label": "측정 종료"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "dumpsys window | grep mCurrentFocus",
        "label": "화면 확인"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "echo CAPTURED files=$(find /storage/emulated/0/DCIM/Camera -type f -newer /data/local/tmp/ux_mark | wc -l) kb=$(find /storage/emulated/0/DCIM/Camera -type f -newer /data/local/tmp/ux_mark -exec du -k {} + | awk '{s+=$1} END {print s+0}'); for f in $(find /storage/emulated/0/DCIM/Camera -type f -newer /data/local/tmp/ux_mark); do content delete --uri content://media/external/file --where \"_data='$f'\"; rm -f \"$f\"; done; find /storage/emulated/0/DCIM/Camera/Cshot -mindepth 1 -type d -empty -delete 2>/dev/null; echo cleaned",
        "label": "촬영 파일 정리"
      }
    },
    {
      "type": "stop_app",
      "params": {
        "package_name": "com.oplus.camera",
        "label": "앱 종료"
      }
    }
  ],
  "loops": [],
  "requirements": {
    "packages": [
      "com.oplus.camera"
    ],
    "sourceWidth": 1272,
    "sourceHeight": 2772,
    "traceType": "fsio_ufs"
  },
  "origin": {
    "deviceModel": "CPH2749"
  }
}
