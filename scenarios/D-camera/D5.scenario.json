{
  "schemaVersion": 1,
  "kind": "scenario",
  "name": "[UX-fsio] D5 동영상 30초 4K",
  "description": "[D5 · P2] 해상도 메뉴에서 4K 를 골라 30초 녹화하고, 측정 뒤 1080p 로 되돌린다. D3(1080p)와 대역 비교. 측정 후 지운다.",
  "repeatCount": 3,
  "steps": [
    {
      "type": "shell",
      "params": {
        "cmd": "touch /data/local/tmp/ux_mark",
        "label": "새 파일 기준 시각 기록"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "am start -W -a android.media.action.VIDEO_CAMERA",
        "label": "카메라(동영상) 실행"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "3",
        "label": "카메라 준비"
      }
    },
    {
      "type": "tap_element",
      "params": {
        "element_resource_id": "com.oplus.camera:id/video_size_and_fps",
        "label": "해상도 메뉴"
      }
    },
    {
      "type": "tap_element",
      "params": {
        "element_text": "4K",
        "label": "4K 선택"
      }
    },
    {
      "type": "key",
      "params": {
        "keycode": "4",
        "label": "메뉴 닫기"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "2",
        "label": "대기 2초"
      }
    },
    {
      "type": "trace_start",
      "params": {
        "trace_type": "fsio_ufs",
        "window_seconds": "1",
        "include_vfs": "false",
        "include_dram": "false",
        "label": "측정 시작"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "input tap 635 2420",
        "label": "녹화 시작"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "30",
        "label": "녹화 30초"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "input tap 635 2420",
        "label": "녹화 종료"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "8",
        "label": "저장 대기"
      }
    },
    {
      "type": "trace_stop",
      "params": {
        "trace_type": "fsio_ufs",
        "label": "측정 종료"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "dumpsys window | grep mCurrentFocus",
        "label": "화면 확인"
      }
    },
    {
      "type": "tap_element",
      "params": {
        "element_resource_id": "com.oplus.camera:id/video_size_and_fps",
        "label": "해상도 메뉴"
      }
    },
    {
      "type": "tap_element",
      "params": {
        "element_text": "1080p",
        "label": "1080p 로 되돌리기"
      }
    },
    {
      "type": "key",
      "params": {
        "keycode": "4",
        "label": "메뉴 닫기"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "echo CAPTURED files=$(find /storage/emulated/0/DCIM/Camera -type f -newer /data/local/tmp/ux_mark | wc -l) kb=$(find /storage/emulated/0/DCIM/Camera -type f -newer /data/local/tmp/ux_mark -exec du -k {} + | awk '{s+=$1} END {print s+0}'); for f in $(find /storage/emulated/0/DCIM/Camera -type f -newer /data/local/tmp/ux_mark); do content delete --uri content://media/external/file --where \"_data='$f'\"; rm -f \"$f\"; done; find /storage/emulated/0/DCIM/Camera/Cshot -mindepth 1 -type d -empty -delete 2>/dev/null; echo cleaned",
        "label": "촬영 파일 정리"
      }
    },
    {
      "type": "stop_app",
      "params": {
        "package_name": "com.oplus.camera",
        "label": "앱 종료"
      }
    }
  ],
  "loops": [],
  "requirements": {
    "packages": [
      "com.oplus.camera"
    ],
    "sourceWidth": 1272,
    "sourceHeight": 2772,
    "traceType": "fsio_ufs"
  },
  "origin": {
    "deviceModel": "CPH2749"
  }
}
