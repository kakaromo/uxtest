{
  "schemaVersion": 1,
  "kind": "scenario",
  "name": "[UX-fsio] E1 갤러리 가벼운 사용",
  "description": "[E1 · P2] 그리드를 20번만 스크롤하고 사진 5장을 본다 (썸네일이 이미 있는 warm 상태). G1·G2(1000장 전체)와 비교할 일상 사용 기준선. 기기에 다른 사진이 없어 NASA 세트 위에서 잰다. 준비: NASA 세트 1000장",
  "repeatCount": 3,
  "steps": [
    {
      "type": "shell",
      "params": {
        "cmd": "sync; echo 3 > /proc/sys/vm/drop_caches",
        "label": "페이지 캐시 비우기"
      }
    },
    {
      "type": "launch_app",
      "params": {
        "package_name": "com.oneplus.gallery",
        "clear_mode": "force_stop",
        "wait_seconds": "5",
        "label": "갤러리 실행"
      }
    },
    {
      "type": "trace_start",
      "params": {
        "trace_type": "fsio_ufs",
        "window_seconds": "1",
        "include_vfs": "false",
        "include_dram": "false",
        "label": "측정 시작"
      }
    },
    {
      "type": "scroll",
      "params": {
        "direction": "down",
        "count": "20",
        "pause": "1",
        "duration": "300",
        "label": "그리드 20번 스크롤"
      }
    },
    {
      "type": "tap",
      "params": {
        "x": "636",
        "y": "1300",
        "label": "사진 열기"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "2",
        "label": "뷰어 로딩"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "for i in 1 2 3 4; do input swipe 1100 1386 170 1386 150; sleep 2; done; echo 4",
        "label": "다음 사진 4장"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "3",
        "label": "writeback 배수 대기"
      }
    },
    {
      "type": "trace_stop",
      "params": {
        "trace_type": "fsio_ufs",
        "label": "측정 종료"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "dumpsys window | grep mCurrentFocus",
        "label": "화면 확인"
      }
    },
    {
      "type": "stop_app",
      "params": {
        "package_name": "com.oneplus.gallery",
        "label": "앱 종료"
      }
    }
  ],
  "loops": [],
  "requirements": {
    "packages": [
      "com.oneplus.gallery"
    ],
    "sourceWidth": 1272,
    "sourceHeight": 2772,
    "traceType": "fsio_ufs"
  },
  "origin": {
    "deviceModel": "CPH2749"
  }
}
