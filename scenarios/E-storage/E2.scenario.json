{
  "schemaVersion": 1,
  "kind": "scenario",
  "name": "[UX-fsio] E2 512MB 파일 복사",
  "description": "[E2 · P1] /sdcard(FUSE 경유)에서 512MB 파일 복사. 원본 생성과 캐시 비우기는 측정 밖.",
  "repeatCount": 3,
  "steps": [
    {
      "type": "shell",
      "params": {
        "cmd": "dd if=/dev/urandom of=/sdcard/ux_src.bin bs=1M count=512 2>&1 | tail -1; sync",
        "label": "원본 512MB 만들기"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "sync; echo 3 > /proc/sys/vm/drop_caches",
        "label": "페이지 캐시 비우기"
      }
    },
    {
      "type": "trace_start",
      "params": {
        "trace_type": "fsio_ufs",
        "window_seconds": "1",
        "include_vfs": "false",
        "include_dram": "false",
        "label": "측정 시작"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "cp /sdcard/ux_src.bin /sdcard/ux_dst.bin && sync && ls -l /sdcard/ux_dst.bin",
        "label": "512MB 복사"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "3",
        "label": "writeback 배수 대기"
      }
    },
    {
      "type": "trace_stop",
      "params": {
        "trace_type": "fsio_ufs",
        "label": "측정 종료"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "rm -f /sdcard/ux_src.bin /sdcard/ux_dst.bin; echo removed",
        "label": "파일 정리"
      }
    }
  ],
  "loops": [],
  "requirements": {
    "packages": [],
    "sourceWidth": 1272,
    "sourceHeight": 2772,
    "traceType": "fsio_ufs"
  },
  "origin": {
    "deviceModel": "CPH2749"
  }
}
