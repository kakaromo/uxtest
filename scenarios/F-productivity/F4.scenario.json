{
  "schemaVersion": 1,
  "kind": "scenario",
  "name": "[UX-fsio] F4 연락처 스크롤·검색",
  "description": "[F4 · P2] 연락처 목록 스크롤과 검색. 작은 read 위주. 연락처가 적으면 I/O 가 거의 없을 수 있다. 준비: 연락처 권한 허용 / dry-run 확인: 검색창 요소",
  "repeatCount": 3,
  "steps": [
    {
      "type": "shell",
      "params": {
        "cmd": "settings put secure selected_input_method_subtype -1097284911; ime set com.google.android.inputmethod.latin/com.android.inputmethod.latin.LatinIME >/dev/null; settings get secure selected_input_method_subtype",
        "label": "키보드 영문(Alphabet)으로"
      }
    },
    {
      "type": "stop_app",
      "params": {
        "package_name": "com.google.android.contacts",
        "label": "앱 종료"
      }
    },
    {
      "type": "launch_app",
      "params": {
        "package_name": "com.google.android.contacts",
        "clear_mode": "force_stop",
        "wait_seconds": "4",
        "label": "연락처 실행"
      }
    },
    {
      "type": "trace_start",
      "params": {
        "trace_type": "fsio_ufs",
        "window_seconds": "1",
        "include_vfs": "false",
        "include_dram": "false",
        "label": "측정 시작"
      }
    },
    {
      "type": "tap_element",
      "params": {
        "element_resource_id": "com.google.android.contacts:id/open_search_bar",
        "label": "검색"
      }
    },
    {
      "type": "text",
      "params": {
        "input_text": "010",
        "submit": "false",
        "label": "검색어 입력"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "3",
        "label": "대기 3초"
      }
    },
    {
      "type": "key",
      "params": {
        "keycode": "4",
        "label": "키보드 닫기"
      }
    },
    {
      "type": "key",
      "params": {
        "keycode": "4",
        "label": "검색 닫기"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "1",
        "label": "대기 1초"
      }
    },
    {
      "type": "scroll",
      "params": {
        "direction": "down",
        "count": "10",
        "pause": "1",
        "duration": "300",
        "label": "목록 스크롤"
      }
    },
    {
      "type": "sleep",
      "params": {
        "seconds": "3",
        "label": "writeback 배수 대기"
      }
    },
    {
      "type": "trace_stop",
      "params": {
        "trace_type": "fsio_ufs",
        "label": "측정 종료"
      }
    },
    {
      "type": "shell",
      "params": {
        "cmd": "dumpsys window | grep mCurrentFocus",
        "label": "화면 확인"
      }
    },
    {
      "type": "stop_app",
      "params": {
        "package_name": "com.google.android.contacts",
        "label": "앱 종료"
      }
    }
  ],
  "loops": [],
  "requirements": {
    "packages": [
      "com.google.android.contacts"
    ],
    "sourceWidth": 1272,
    "sourceHeight": 2772,
    "traceType": "fsio_ufs"
  },
  "origin": {
    "deviceModel": "CPH2749"
  }
}
